{
  "name": "bolio-icons-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "export": "yarn build",
    "clear-all": "rm -rf .next _static node_modules",
