    "re-build": "rm -rf .next _static node_modules && yarn install && yarn build"
  },
  "dependencies": {
    "@bolio-ui/core": "^3.0.2",
    "@bolio-ui/icons": "^1.0.4",
    "next": "^15.5.27",
    "next-pwa": "^5.6.0",
    "next-seo": "^6.8.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
